---
import Layout from '../../layouts/Layout.astro'; import PageHero from '../../components/PageHero.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import FinalCta from '../../components/FinalCta.astro'; import { solutions } from '../../data/site';
---
<Layout title="W4U per professionisti, autori, formatori e aziende" description="Scopri come W4U aiuta professionisti, autori esordienti, formatori, coach, imprenditori e aziende a trasformare conoscenza e idee in un libro."><Breadcrumbs items={[{label:'Per chi è'}]} /><PageHero eyebrow="PER CHI È W4U" title="Ogni libro parte da un patrimonio diverso." description="Un’esperienza, una storia, un metodo o una visione: W4U adatta le domande e la struttura al progetto che vuoi realizzare." /><section class="section-space"><div class="site-shell solution-grid solution-grid-large">{solutions.map((solution,index) => <a class="solution-card" href={`/soluzioni/${solution.slug}/`}><span>0{index+1}</span><small>{solution.eyebrow}</small><h2>{solution.title}</h2><p>{solution.description}</p><ul>{solution.bullets.map((bullet) => <li>{bullet}</li>)}</ul><i>Esplora questa soluzione →</i></a>)}</div></section><FinalCta title="Il punto di partenza è già tuo." text="Porta esperienza, appunti o un’idea. W4U ti aiuta a trovare la forma editoriale adatta." /></Layout>
