---
import Layout from '../../layouts/Layout.astro'; import PageHero from '../../components/PageHero.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import FinalCta from '../../components/FinalCta.astro'; import { solutions, processSteps } from '../../data/site';
export function getStaticPaths(){return solutions.map((solution)=>({params:{slug:solution.slug},props:{solution}}));}
const {solution}=Astro.props; const title=`W4U per ${solution.eyebrow.toLowerCase()} | Crea il tuo libro`; const schema={'@context':'https://schema.org','@type':'WebPage',name:title,description:solution.description};
---
<Layout title={title} description={solution.description} schema={schema}><Breadcrumbs items={[{label:'Per chi è',href:'/soluzioni/'},{label:solution.eyebrow}]} /><PageHero eyebrow={solution.eyebrow} title={solution.title} description={solution.description} /><section class="section-space"><div class="site-shell audience-grid"><div><span class="tag">COSA PUOI OTTENERE</span><h2>Dal materiale sparso a una direzione leggibile.</h2><p>W4U trasforma il punto di partenza in una sequenza di scelte editoriali chiare, senza chiederti di progettare da solo l’intero processo.</p></div><ul>{solution.bullets.map((bullet) => <li><span>✓</span>{bullet}</li>)}</ul></div></section><section class="section-space"><div class="site-shell section-heading"><div class="eyebrow"><span></span> NEL PERCORSO</div><h2>Tre momenti decisivi.</h2></div><div class="site-shell mini-step-grid">{[processSteps[2],processSteps[4],processSteps[6]].map((step)=><article><span>{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></section><FinalCta title="Dai una forma editoriale a ciò che sai." /></Layout>
