---
import Layout from '../../layouts/Layout.astro'; import PageHero from '../../components/PageHero.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import FinalCta from '../../components/FinalCta.astro'; import { appLink } from '../../config';
---
<Layout title="Contatti e assistenza | W4U" description="Hai domande sul percorso W4U? Scopri i canali di assistenza per progetti, accesso alla piattaforma e informazioni commerciali."><Breadcrumbs items={[{label:'Contatti'}]} /><PageHero eyebrow="CONTATTI" title="Parliamo del tuo prossimo progetto." description="Per domande sul prodotto, sull’accesso o sul tuo progetto editoriale puoi usare i canali di assistenza integrati nella piattaforma." /><section class="section-space"><div class="site-shell contact-grid"><article><span>01</span><h2>Hai già un account?</h2><p>Accedi alla webapp e usa il supporto contestuale: ci permette di capire meglio il progetto e la fase in cui ti trovi.</p><a class="text-link" href={appLink('/login')}>Accedi a W4U →</a></article><article><span>02</span><h2>Vuoi conoscere W4U?</h2><p>Consulta il percorso, le funzionalità e le risposte frequenti prima di avviare il progetto dimostrativo.</p><a class="text-link" href="/faq/">Leggi le FAQ →</a></article></div><div class="site-shell contact-note"><strong>Nota per la pubblicazione</strong><p>Il recapito commerciale definitivo sarà inserito prima della messa online. Evitiamo di mostrare indirizzi provvisori o non verificati.</p></div></section><FinalCta /></Layout>
