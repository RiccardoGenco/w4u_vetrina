---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import FinalCta from '../../components/FinalCta.astro';
import { appLink } from '../../config';

const pricingFaq = [
  { question: 'La demo è davvero gratuita?', answer: 'Sì. Dopo la registrazione puoi creare gratuitamente un libro demo completo di 30 pagine, senza acquistare credito.' },
  { question: 'Cosa comprende la demo?', answer: 'Un unico libro demo da 30 pagine, con il percorso W4U in otto fasi, struttura, scrittura progressiva, editor e finalizzazione del progetto.' },
  { question: 'Quanto costa un libro completo?', answer: 'Il credito necessario parte da 30 € per le prime 50 pagine. Ogni blocco aggiuntivo di 10 pagine costa 5 €, fino a un massimo di 250 pagine.' },
  { question: 'Come funzionano i pagamenti?', answer: 'Ricarichi il tuo wallet e il costo viene scalato al momento della generazione del libro. Il credito non scade e non ci sono rinnovi automatici.' },
  { question: 'Se la generazione si interrompe?', answer: 'Un eventuale nuovo tentativo sullo stesso libro non richiede un secondo addebito. Il progetto resta salvato e puoi riprenderlo.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: pricingFaq.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) };
---
<Layout title="Prezzi W4U | Demo gratis e libri da 30 €" description="Prova W4U gratis dopo la registrazione con un libro demo di 30 pagine. Per i libri completi: 30 € fino a 50 pagine, poi 5 € ogni 10 pagine." schema={schema}>
  <Breadcrumbs items={[{ label: 'Prezzi' }]} />
  <PageHero eyebrow="PREZZI TRASPARENTI" title="Prima prova. Poi scegli quanto far crescere il tuo libro." description="Registrati gratuitamente: la demo è libera e include un libro completo di 30 pagine. Quando vorrai proseguire, pagherai solo in base alla lunghezza del nuovo progetto." cta="Crea la demo gratuita" />

  <section class="pricing-intro section-space">
    <div class="site-shell pricing-intro-grid">
      <div class="section-heading"><div class="eyebrow"><span></span> IL PRIMO PASSO È GRATIS</div><h2>Una demo vera,<br />non una schermata da provare.</h2><p>La registrazione apre un progetto demo completo. Puoi seguire il metodo W4U, approvare la struttura e arrivare a un libro di 30 pagine senza alcun acquisto.</p></div>
      <article class="demo-card"><div><span class="tag">DEMO GRATUITA</span><strong>0 €</strong><p>1 libro completo · 30 pagine</p></div><ul><li>Registrazione gratuita</li><li>Percorso editoriale in otto fasi</li><li>Testo modificabile e progetto salvato</li><li>Nessun abbonamento o rinnovo automatico</li></ul><a class="button" href={appLink('/register')}>Inizia la demo gratis <span>→</span></a></article>
    </div>
  </section>

  <section class="pricing-paid section-space">
    <div class="site-shell"><div class="section-heading centered"><div class="eyebrow"><span></span> QUANDO SEI PRONTO A PROSEGUIRE</div><h2>Un prezzo che segue<br />la dimensione del libro.</h2><p>Ricarichi il wallet una volta, poi il credito viene usato quando avvii un nuovo libro completo.</p></div><div class="pricing-explainer"><article class="price-rule"><span>BASE</span><strong>30 €</strong><p>fino a <b>50 pagine</b></p></article><div class="price-rule-plus" aria-hidden="true">+</div><article class="price-rule"><span>ESTENSIONE</span><strong>5 €</strong><p>ogni <b>10 pagine</b> in più</p></article><div class="price-rule-equals" aria-hidden="true">=</div><article class="price-rule price-rule-result"><span>LIMITE</span><strong>250</strong><p>pagine per libro</p></article></div><div class="pricing-table-wrap"><table class="pricing-table"><caption>Esempi di costo per un libro completo</caption><thead><tr><th scope="col">Lunghezza del libro</th><th scope="col">Credito necessario</th><th scope="col">Formula</th></tr></thead><tbody><tr><td>50 pagine</td><td><b>30 €</b></td><td>costo base</td></tr><tr><td>100 pagine</td><td><b>55 €</b></td><td>30 € + 5 blocchi da 5 €</td></tr><tr><td>150 pagine</td><td><b>80 €</b></td><td>30 € + 10 blocchi da 5 €</td></tr><tr><td>200 pagine</td><td><b>105 €</b></td><td>30 € + 15 blocchi da 5 €</td></tr><tr><td>250 pagine</td><td><b>130 €</b></td><td>30 € + 20 blocchi da 5 €</td></tr></tbody></table></div><p class="pricing-note">Il credito non scade. Nessun abbonamento, nessun rinnovo automatico: acquisti credito e lo usi quando decidi tu.</p></div>
  </section>

  <section class="section-space"><div class="site-shell pricing-assurance"><div><div class="eyebrow"><span></span> COSA RICEVI</div><h2>Il costo copre il libro,<br />non soltanto il testo.</h2></div><ul><li>Intervista e percorso guidato per partire anche da un’idea incompleta</li><li>Struttura editoriale da approvare prima della scrittura</li><li>Capitoli modificabili, salvataggio e ripresa del progetto</li><li>Copertina, impaginazione ed esportazione in PDF, EPUB e DOCX</li></ul></div></section>

  <section class="section-space"><div class="site-shell faq-grid"><div class="section-heading"><div class="eyebrow"><span></span> DOMANDE SUI PREZZI</div><h2>Tutto chiaro,<br />prima di iniziare.</h2></div><FaqList items={pricingFaq} /></div></section>
  <FinalCta />
</Layout>
