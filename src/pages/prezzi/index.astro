---
import Layout from '../../layouts/Layout.astro'; import PageHero from '../../components/PageHero.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import FaqList from '../../components/FaqList.astro'; import FinalCta from '../../components/FinalCta.astro'; import { appLink } from '../../config';
const pricingFaq=[{question:'Posso provare W4U prima di scegliere?',answer:'Sì. L’accesso iniziale permette di esplorare il percorso e creare un primo progetto dimostrativo. Le condizioni commerciali definitive saranno presentate chiaramente nella webapp.'},{question:'Cosa comprende il progetto?',answer:'Il percorso guidato, la struttura editoriale, lo sviluppo progressivo del contenuto, l’editor, la copertina e i formati di esportazione previsti.'},{question:'Il prezzo dipende dal numero di parole?',answer:'W4U ragiona sul progetto e sulle pagine formattate, non promette un numero rigido di parole. Estensione e risultato dipendono dalle scelte editoriali.'}];
---
<Layout title="Prezzi W4U | Prova il percorso editoriale" description="Scopri l’accesso iniziale a W4U e cosa comprende il percorso per trasformare la tua idea in un libro strutturato ed esportabile."><Breadcrumbs items={[{label:'Prezzi'}]} /><PageHero eyebrow="PREZZI" title="Inizia dal progetto, scegli con consapevolezza." description="Esplora il percorso W4U con un progetto dimostrativo. Le condizioni commerciali vengono mostrate nella webapp prima di ogni acquisto." /><section class="section-space"><div class="site-shell pricing-wrap"><article class="pricing-card"><span class="tag">ACCESSO INIZIALE</span><h2>Progetto Demo</h2><p class="price-label">Prova il metodo W4U</p><ul><li>Un progetto guidato</li><li>Percorso editoriale in otto fasi</li><li>Fino a 30 pagine formattate nel piano demo</li><li>Controllo e modifica dei contenuti</li></ul><a class="button" href={appLink('/register')}>Inizia il progetto <span>→</span></a><small>Nessun prezzo inventato: importi e condizioni saranno sincronizzati con la webapp prima della pubblicazione.</small></article><div class="pricing-copy"><h2>Un prezzo leggibile, come il percorso.</h2><p>La pagina è predisposta per presentare piani, limiti e condizioni senza ambiguità. In questa versione locale mostriamo solo le informazioni confermate dal prodotto.</p><div class="trust-list"><span>✓ Nessun rinnovo nascosto</span><span>✓ Condizioni visibili prima dell’acquisto</span><span>✓ Progetto sempre sotto il tuo controllo</span></div></div></div></section><section class="section-space"><div class="site-shell faq-grid"><div class="section-heading"><div class="eyebrow"><span></span> PREZZI E PERCORSO</div><h2>Domande frequenti.</h2></div><FaqList items={pricingFaq} /></div></section><FinalCta /></Layout>
