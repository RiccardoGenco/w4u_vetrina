---
import { getCollection } from 'astro:content'; import Layout from '../../layouts/Layout.astro'; import PageHero from '../../components/PageHero.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import FinalCta from '../../components/FinalCta.astro';
const posts=(await getCollection('risorse',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Layout title="Risorse per scrivere e progettare un libro | W4U" description="Guide pratiche su idea, indice, struttura, tempi di scrittura e formati editoriali per trasformare un progetto in un libro."><Breadcrumbs items={[{label:'Risorse'}]} /><PageHero eyebrow="RISORSE" title="Il lavoro editoriale, spiegato con chiarezza." description="Guide pratiche per progettare, strutturare, revisionare e preparare un libro con maggiore consapevolezza." /><section class="section-space"><div class="site-shell resource-grid">{posts.map((post,index)=><a class:list={['resource-card',index===0&&'resource-featured']} href={`/risorse/${post.id}/`}><span>{post.data.category}</span><h2>{post.data.title}</h2><p>{post.data.description}</p><div><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('it-IT',{day:'numeric',month:'short',year:'numeric'})}</time><i>Leggi la guida →</i></div></a>)}</div></section><FinalCta title="Hai già abbastanza materiale per cominciare." text="Trasforma appunti, esperienza e idee in un progetto editoriale guidato." /></Layout>
