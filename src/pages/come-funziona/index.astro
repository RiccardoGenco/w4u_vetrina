---
import Layout from '../../layouts/Layout.astro'; import PageHero from '../../components/PageHero.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import FinalCta from '../../components/FinalCta.astro'; import { processSteps } from '../../data/site';
---
<Layout title="Come funziona W4U | Il percorso editoriale in 8 fasi" description="Scopri le otto fasi con cui W4U trasforma un’idea in un libro strutturato, modificabile ed esportabile in PDF, EPUB e DOCX."><Breadcrumbs items={[{label:'Come funziona'}]} /><PageHero eyebrow="IL PERCORSO W4U" title="Un libro completo, una decisione alla volta." description="W4U organizza il lavoro in otto fasi collegate. Ogni passaggio conserva il contesto e prepara quello successivo." /><section class="section-space"><div class="site-shell timeline">{processSteps.map((step) => <article><span>{step.number}</span><div><small>{step.short}</small><h2>{step.title}</h2><p>{step.text}</p></div></article>)}</div></section><section class="section-space narrow-section"><div class="site-shell editorial-note"><div><span class="tag">CONTROLLO EDITORIALE</span><h2>Tu approvi la direzione.</h2></div><p>Il flusso non elimina il ruolo dell’autore: lo rende più gestibile. Titolo, indice, tono e contenuti restano modificabili. Per dati, fonti e argomenti sensibili è sempre necessaria una verifica umana.</p></div></section><FinalCta /></Layout>
