---
import Layout from '../../layouts/Layout.astro'; import PageHero from '../../components/PageHero.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import FinalCta from '../../components/FinalCta.astro'; import { features } from '../../data/site';
const details=[['intervista','Intervista editoriale','Domande progressive raccolgono obiettivo, lettore, promessa, materiali ed esempi. Parti anche da appunti non ordinati.'],['struttura','Titolo, concept e blueprint','Prima della scrittura definisci la direzione: proposte di titolo, concept, tono, pubblico, indice e obiettivo di ogni capitolo.'],['scrittura','Produzione progressiva','Il manoscritto prende forma per capitoli e sezioni. Il contesto approvato guida la continuità del lavoro.'],['editor','Editor e progetto riprendibile','Rivedi i testi, aggiungi la tua voce e torna sul progetto quando vuoi senza perdere lo stato raggiunto.'],['finalizzazione','Copertina e impaginazione','Completa la veste del progetto con copertina e scelte di layout coerenti con il contenuto.'],['export','Esportazione multiformato','Prepara PDF, EPUB e DOCX per lettura, condivisione e successive revisioni.']];
---
<Layout title="Funzionalità W4U | Dall’intervista all’esportazione" description="Intervista editoriale, blueprint, scrittura progressiva, editor, copertina ed export PDF, EPUB e DOCX: scopri le funzionalità di W4U."><Breadcrumbs items={[{label:'Funzionalità'}]} /><PageHero eyebrow="FUNZIONALITÀ" title="Tutto ciò che serve per far avanzare il tuo libro." description="Un unico ambiente per raccogliere le idee, progettare la struttura, sviluppare il testo e preparare i file finali." /><section class="section-space"><div class="site-shell feature-detail-list">{details.map((item,index) => <article id={item[0]}><span>0{index+1}</span><div><small>{features[index].title}</small><h2>{item[1]}</h2><p>{item[2]}</p><ul><li>Passaggio guidato e contestuale</li><li>Risultato modificabile e approvabile</li><li>Stato salvato nel progetto</li></ul></div></article>)}</div></section><FinalCta /></Layout>
