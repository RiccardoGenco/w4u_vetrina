---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import { appLink } from '../config';
import { ClientRouter } from 'astro:transitions';
import MotionDirector from '../components/MotionDirector.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  socialImage?: string | false;
}

const {
  title = 'W4U — Dalla tua idea a un libro vero',
  description = 'W4U ti accompagna dall’idea a un libro strutturato, modificabile e pronto da scaricare in PDF, EPUB e DOCX.',
  canonical = Astro.url.pathname,
  noindex = false,
  schema,
  socialImage: socialImagePath = '/og.png',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('http://localhost:4321');
const canonicalUrl = new URL(canonical, siteUrl);
const socialImage = socialImagePath ? new URL(socialImagePath, siteUrl) : undefined;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const currentPath = Astro.url.pathname;
const isCurrent = (path: string) => path === '/' ? currentPath === '/' : currentPath.startsWith(path);
---

<!doctype html>
<html lang="it" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#050505" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="W4U" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content="W4U — Dalla tua idea a un libro vero" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\\u003c')} />)}
    <ClientRouter />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('w4u-theme');
        const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <MotionDirector />
    <header class="site-header">
      <div class="site-shell nav-shell">
        <Logo />
        <nav class="desktop-nav" aria-label="Navigazione principale">
          <a href="/come-funziona/" aria-current={isCurrent('/come-funziona/') ? 'page' : undefined}>Come funziona</a>
          <a href="/funzionalita/" aria-current={isCurrent('/funzionalita/') ? 'page' : undefined}>Funzionalità</a>
          <a href="/soluzioni/" aria-current={isCurrent('/soluzioni/') ? 'page' : undefined}>Per chi è</a>
          <a href="/risorse/" aria-current={isCurrent('/risorse/') ? 'page' : undefined}>Risorse</a>
          <a href="/prezzi/" aria-current={isCurrent('/prezzi/') ? 'page' : undefined}>Prezzi</a>
        </nav>
        <div class="nav-actions">
          <button class="theme-toggle" type="button" aria-label="Cambia tema" data-theme-toggle><span aria-hidden="true">◐</span></button>
          <a class="nav-login" href={appLink('login')}>Accedi</a>
          <a class="button button-small" href={appLink('register')}>Inizia ora</a>
        </div>
        <button class="menu-toggle" type="button" aria-label="Apri menu" aria-expanded="false" data-menu-toggle><span></span><span></span></button>
      </div>
      <nav class="mobile-nav" aria-label="Navigazione mobile" data-mobile-nav hidden>
        <a href="/come-funziona/">Come funziona</a><a href="/funzionalita/">Funzionalità</a><a href="/soluzioni/">Per chi è</a><a href="/risorse/">Risorse</a><a href="/prezzi/">Prezzi</a><a href="/faq/">FAQ</a>
      </nav>
    </header>
    <main id="contenuto"><slot /></main>
    <Footer />
    <script>
      const toggle = document.querySelector('[data-theme-toggle]');
      toggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('w4u-theme', next);
      });
      const menuToggle = document.querySelector('[data-menu-toggle]');
      const mobileNav = document.querySelector('[data-mobile-nav]');
      menuToggle?.addEventListener('click', () => {
        const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', String(!expanded));
        if (mobileNav instanceof HTMLElement) mobileNav.hidden = expanded;
      });
    </script>
  </body>
</html>
